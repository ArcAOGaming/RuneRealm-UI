# The mint ledger is per-machine: it records transaction ids between signing
# and reporting, and sharing one between machines would let two workers each
# think the other's job is done. mint-collection.json is NOT ignored -- it is
# the only record of which collection this deployment owns.
backend/native/mint-ledger.json
.cards/

# Contact sheets from tools/gen-icons.py --sheet. Eyeballing only; the real
# icons land in public/.
.icons/

# Fuzz run artefacts
.fuzz/

# Fixture for exercising the incremental Permaweb uploader
.test-site/

# Load/latency ladder artefacts and local run logs
.ladder/
.devserver.log
.redeploy.log

# A separate checkout that lives inside this one. 216 MB of somebody else's
# repository is not this repository's history.
hyper-Real/

# The shape of `cmd > $UNSET_VAR`. Never deliberate.
undefined/

# Working copies kept beside the file they were taken from.
*.bak

# Soak results. The finding goes in a doc; the raw run is machine-local and
# there is one of these per experiment.
backend/native/battle-fleet/hblab/soak-*.json
