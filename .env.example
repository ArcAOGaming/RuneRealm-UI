# All VITE_* values are public in the browser bundle.
# Process ids, nodes and the game owner are not env: they come from
# src/lib/graph.json, generated from the deployment record by graph:sync.

VITE_ASSET_NODE=https://hb.arweave.net
VITE_ARWEAVE_GATEWAY=https://arweave.net

# Build-only switch read by vite.config.ts. It is not exposed to the browser.
BUILD_SOURCEMAP=false
