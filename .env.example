# Copy to .env.local to override the defaults baked into src/lib/hyperbeam.ts.

# The game process. Written to live-process.txt by backend/native/deploy.mjs.
VITE_GAME_PROCESS=DnM_Uy7MbKQXk-EJONp4g-jAsLiHnXTa-KOuv1tffPU
VITE_HUNT_PROCESS=G3iJTMNr_AtK78UNAWMAFs96p6JRjzBs4vE1mfUrlms
VITE_HUNT_NODE=https://hyperbeam.tylerw.ai
VITE_GAME_OWNER=DA9qhP25ZPz6MHIhO-7aNHDN3LsTAL7yCKYIkqr13Z8

# Which HyperBEAM node to talk to. Node health is not uniform — see HYPERBEAM.md.
# Verified good: schedule.forward.computer, jonny-ringo.xyz
#
# CHECK THE NODE'S IDENTITY BEFORE BELIEVING A TIMING NUMBER — not its DNS.
# On 2026-09-07 the A record for hyperbeam.tylerw.ai moved from 49.12.125.122
# (i7-6700, 4 cores) to 176.9.219.106 (i9-9900K, 8 cores), and for a few hours
# in between it landed on that box's default nginx vhost and served someone
# else's certificate. That is fixed: the hostname now has its own vhost and a
# valid certificate, and the node behind it is a fresh identity. So the check
# is not "where does the name resolve", it is:
#
#   curl https://hyperbeam.tylerw.ai/~meta@1.0/info/address
#   tkqULqMDeHKXCN79Cm_bDIV560JxXl6pBSmdPgxqwSw   <- the current (i9) node
#   A19Lb486Yq73LzCYLa3Pswt5QmXjCjGv2Dik3Bpdguk   <- the previous (i7) node
#
# Do not health-check /~meta@1.0/info: every device answers `info` itself and
# the node hands back its own HTML landing page at status 200.
VITE_HB_NODE=https://hyperbeam.tylerw.ai

# Node live-test tools resolve one process graph from the deployment receipts.
# Override the graph only when intentionally testing another deployment. A
# NODE_URL relay override is propagated to every component; component-specific
# values win when Hunt or the exchange genuinely lives elsewhere.
# GAME_PROCESS=<game-pid>
# NODE_URL=http://127.0.0.1:<browser-relay-port>
# HUNT_PROCESS=<hunt-lead-pid>
# HUNT_NODE=<hunt-node>
# RUNE_PROCESS=<rune-pid>
# QUOTE_PROCESS=<quote-pid>
# MARKET_NODE=<exchange-node>

# Full process release policy (server-side; never exposed as a VITE_ variable).
# Leave unset for Eternal Pass access. Set to 1 when running deploy:all to let
# any signed wallet create an account. See README "Open-access deployments".
# PUBLIC_ACCESS=1

# --- Asset tooling (build-time only, NEVER prefix with VITE_) ---
# VITE_ vars are inlined into the browser bundle. An API key with a VITE_
# prefix is published to every visitor. These are read by tools/ scripts only.

# PixelLab: monster sprite generation + skeleton/text animation.
# Key from https://www.pixellab.ai account settings.
PIXELLAB_API_KEY=

# Retro Diffusion runs LOCALLY via the Aseprite extension (no key needed).
# Only set this if you also buy cloud API credits for batch generation.
RETRO_DIFFUSION_API_KEY=

# --- Minting (build-time / worker only, NEVER prefix with VITE_) ---
# The wallet that signs asset transactions and pays the AR. It must be the
# process OWNER: the worker reports mints through Admin.* handlers.
# HB_WALLET=path/to/key.json

# Where the worker reads the queues from and where it sends admin messages.
# NODE_URL=https://schedule.forward.computer

# Seconds between passes when running `npm run mint:worker`.
# MINT_POLL_MS=60000

# --- Minting (client) ---
# Asset state lives on a node that indexes Arweave. schedule.forward.computer
# answers 500 for every token@1.0 asset; hb.arweave.net serves them.
VITE_ASSET_NODE=https://hb.arweave.net
VITE_ARWEAVE_GATEWAY=https://arweave.net

# --- Rune Realm marketplace ---
# Written automatically by `npm run deploy:marketplace`. Leave blank before
# the first deploy; the screen will show a safe "not deployed" state.
#
# There is no VITE_AMM_PROCESS any more. The constant-product pool was replaced
# by the two order-book venues below, nothing in src/ reads the variable, and
# the id it used to carry (vAhjQlZ...) lives on a node this repo no longer
# deploys to — so leaving it here only invited someone to wire a wallet to it.
VITE_RUNE_PROCESS=lOW-gbK2i6SHyWgkeS0q7cog5cN3J2Vfr76Jc1Z_60A
VITE_QUOTE_PROCESS=quRPySI5_B0ZduY4d_p8ozc2iZ0SYqQiUQZyGF5bmp0
VITE_MARKET_NODE=https://hyperbeam.tylerw.ai
VITE_INTERNAL_VENUE_PROCESS=h-tIieBB0euTMLtnpYj9A5O4eFIN4x4a2POgd7y24ys
VITE_EXTERNAL_VENUE_PROCESS=aNtH8d-SWgTBzx1wL4krKgzL9V8aJ_NDkVIMpbSyzls
VITE_VENUE_NODE=https://hyperbeam.tylerw.ai
