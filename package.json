{
  "name": "rune-realm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "monster-index:sync": "node tools/sync-monster-index.mjs",
    "monster-index:check": "node tools/sync-monster-index.mjs --check",
    "test:lua": "bash backend/native/run-test.sh",
    "test:scale": "bash backend/native/run-scale-guard.sh",
    "test:hyperdb": "node backend/native/hyperdb/run-local-test.mjs",
    "bench:hyperdb": "node backend/native/hyperdb/benchmark.mjs",
    "test:lua:local": "node backend/native/run-local-game-test.mjs",
    "test:minify": "node --test backend/native/lua-minify.test.mjs",
    "test:hunt": "node backend/native/run-local-hunt-test.mjs",
    "profile:lua:local": "node backend/native/run-local-profile.mjs",
    "deploy:process": "npm run monster-index:check && node backend/native/deploy.mjs",
    "deploy:hunt": "npm run monster-index:check && node backend/native/deploy-hunt.mjs",
    "deploy:battle-fleet": "node backend/native/battle-fleet/deploy-workers.mjs",
    "deploy:site": "node backend/native/deploy-site.mjs",
    "deploy:site:check": "node backend/native/deploy-site.mjs --check",
    "deploy:site:build": "npm run build && npm run deploy:site",
    "deploy:site:test": "node backend/native/deploy-site.mjs --folder .test-site",
    "test:turbo": "node --test backend/native/turbo-incremental.test.mjs",
    "turbo:balance": "node backend/native/turbo.mjs balance",
    "sched:status": "node backend/native/scheduler-location.mjs status",
    "sched:publish": "node backend/native/scheduler-location.mjs publish",
    "turbo:price": "node backend/native/turbo.mjs price",
    "turbo:topup": "node backend/native/turbo.mjs topup",
    "recover:state": "node backend/native/recover-state.mjs",
    "recover:build": "node backend/native/build-legacy.mjs",
    "recover:verify": "node backend/native/verify-legacy.mjs",
    "test:rune": "bash backend/native/run-rune-test.sh",
    "test:marketplace": "bash backend/native/run-marketplace-test.sh",
    "test:marketplace:local": "node backend/native/run-local-marketplace-test.mjs",
    "test:swarm": "node backend/native/swarm/swarm.test.mjs",
    "test:battle-fleet": "node backend/native/battle-fleet/run-local-test.mjs && node backend/native/battle-fleet-integration.mjs && node --test backend/native/battle-fleet/allocator.test.mjs backend/native/battle-fleet/http-error.test.mjs backend/native/battle-fleet/probe-devices.test.mjs backend/native/battle-fleet/manifest.test.mjs backend/native/battle-fleet/mixed-runtime-contract.test.mjs backend/native/battle-fleet-config.test.mjs backend/native/battle-fleet-recovery.test.mjs",
    "test:battle-rust": "cargo test --offline --manifest-path backend/native/battle-fleet-rust/Cargo.toml",
    "build:battle-rust": "node backend/native/battle-fleet-rust/build.mjs",
    "publish:battle-image": "node backend/native/battle-fleet/image.mjs",
    "bench:battle-fleet": "node backend/native/battle-fleet/bench-workers.mjs",
    "bench:battle-runtimes": "node backend/native/battle-fleet/bench-runtimes.mjs",
    "bench:battle-throughput": "node backend/native/battle-fleet/bench-throughput.mjs",
    "hblab:seed": "node backend/native/battle-fleet/hblab/seed.mjs",
    "hblab:harvest": "node backend/native/battle-fleet/hblab/harvest.mjs",
    "probe:battle-devices": "node backend/native/battle-fleet/probe-devices.mjs",
    "probe:battle-rust": "node backend/native/battle-fleet/probe-rust-worker.mjs",
    "configure:battle-fleet": "node backend/native/configure-battle-fleet.mjs",
    "reconcile:battle-fleet": "node backend/native/reconcile-battle-fleet.mjs",
    "swarm": "node backend/native/swarm.mjs run",
    "swarm:plan": "node backend/native/swarm.mjs plan",
    "swarm:wallets": "node backend/native/swarm.mjs wallets",
    "swarm:unlock": "node backend/native/burners.mjs unlock",
    "parked:mint:worker": "node backend/native/mint-worker.mjs",
    "parked:mint:once": "node backend/native/mint-worker.mjs --once",
    "parked:mint:dry": "node backend/native/mint-worker.mjs --dry-run",
    "parked:collection": "node backend/native/collection.mjs",
    "cards": "node backend/native/card/cli.mjs --all --out .cards",
    "deploy:rune": "node backend/native/deploy-rune.mjs",
    "deploy:exchange": "node backend/native/deploy-marketplace.mjs",
    "deploy:contracts:plan": "npm run monster-index:check && node backend/native/redeploy.mjs --plan --free --with-bots",
    "deploy:contracts:check": "npm run monster-index:check && node backend/native/redeploy.mjs --preflight-only --free --with-bots",
    "deploy:contracts": "npm run monster-index:check && node backend/native/redeploy.mjs --free --with-bots",
    "deploy:contracts:resume": "npm run monster-index:check && node backend/native/redeploy.mjs --free --with-bots --resume",
    "deploy:contracts:final:plan": "npm run monster-index:check && node backend/native/redeploy.mjs --plan --seed",
    "deploy:contracts:final:check": "npm run monster-index:check && node backend/native/redeploy.mjs --preflight-only --seed",
    "deploy:contracts:final": "npm run monster-index:check && node backend/native/redeploy.mjs --seed",
    "deploy:all": "node backend/native/redeploy.mjs",
    "redeploy": "node backend/native/redeploy.mjs",
    "fuzz": "node backend/native/fuzz.mjs",
    "fuzz:quick": "node backend/native/fuzz.mjs --ops 1500 --wallets 20",
    "fuzz:soak": "node backend/native/fuzz.mjs --ops 30000 --wallets 50",
    "simulate:economy": "node backend/native/economy-sim.mjs",
    "swarm:verify": "node backend/native/swarm/verify.mjs",
    "read-load": "node backend/native/read-load.mjs",
    "amm-load": "node backend/native/amm-load.mjs",
    "test:lua:smoke": "bash backend/native/run-smoke.sh",
    "probe:heap": "bash backend/native/run-heap-probe.sh",
    "bench:system": "node backend/native/run-local-profile.mjs",
    "bench:compare": "node backend/native/bench-compare.mjs",
    "seed:monsters": "node backend/native/seed-monsters.mjs",
    "seed:monsters:plan": "node backend/native/seed-monsters.mjs --plan",
    "fleet:prepare": "npm run swarm:wallets && npm run swarm:unlock && npm run seed:monsters",
    "fleet:check": "node backend/native/seed-monsters.mjs --plan",
    "test:arlmdb": "node --test backend/native/arlmdb/arlmdb.test.mjs",
    "probe:arlmdb": "node backend/native/arlmdb/probe.mjs",
    "read:arlmdb": "node backend/native/arlmdb/read.mjs --golden --verify",
    "arlmdb:runerealm": "node backend/native/arlmdb/runerealm.mjs",
    "hyper:install": "npm --prefix hyper-Real install",
    "hyper:build": "npm --prefix hyper-Real run build:all",
    "hyper:test": "npm --prefix hyper-Real run test:rules",
    "hyper:deploy": "npm --prefix hyper-Real run deploy",
    "hyper:dev": "npm --prefix hyper-Real start",
    "hyper:site": "npm --prefix hyper-Real run build",
    "hyper:release": "npm run hyper:build && npm run hyper:test && npm run hyper:deploy"
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "^1.42.0",
    "@dha-team/arbundles": "^1.0.4",
    "@types/three": "^0.185.4",
    "arweave": "^1.15.7",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-router-dom": "^6.26.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@permaweb/ao-loader": "^0.0.49",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "permaweb-deploy": "^1.1.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "8.3.2"
    }
  }
}
